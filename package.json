{
  "name": "pulsesync-better-player",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Fullscreen player customization for PulseSync WebHost",
  "scripts": {
    "dev": "node ./scripts/dev-build.mjs",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:modules": "node ./scripts/module-compile.mjs",
    "format": "oxfmt .",
    "sync": "node ./scripts/sync-addon.mjs",
    "build:sync": "yarn build && yarn sync",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@pulsesync/addon-sdk": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "oxfmt": "0.71.0"
  },
  "packageManager": "yarn@1.22.22"
}
